rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedOwnerEmail() {
      return request.auth.token.email_verified == true &&
             request.auth.token.email == 'gulfamahmadrajpoot@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedOwnerEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAdminClaim(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.role == 'owner' &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidOwnerMeta(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.claimed is bool &&
             data.salt is string && data.salt.size() >= 16 && data.salt.size() <= 128 &&
             data.passHash is string && data.passHash.size() >= 32 && data.passHash.size() <= 128 &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidGameConfigDoc(data) {
      return data.configJson is string && data.configJson.size() >= 2 && data.configJson.size() <= 450000 &&
             data.version is int && data.version >= 1 && data.version <= 1000000 &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('publishedAt' in data) || (data.publishedAt is timestamp && data.publishedAt <= request.time));
    }

    function isValidBackupDoc(data) {
      return data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
             data.configJson is string && data.configJson.size() >= 2 && data.configJson.size() <= 450000 &&
             data.version is int && data.version >= 1 && data.version <= 1000000 &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPlayerDoc(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.cash is int && data.cash >= 0 && data.cash <= 100000000 &&
             data.xp is int && data.xp >= 0 && data.xp <= 100000000 &&
             data.level is int && data.level >= 1 && data.level <= 10000 &&
             data.selectedCityId is string && data.selectedCityId.size() >= 1 && data.selectedCityId.size() <= 64 &&
             data.completedMissionsCount is int && data.completedMissionsCount >= 0 && data.completedMissionsCount <= 5000 &&
             data.banned is bool &&
             data.resetRequested is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() &&
                       isValidId(uid) &&
                       request.auth.uid == uid &&
                       isBootstrappedOwnerEmail() &&
                       incoming().keys().hasAll(['uid', 'role', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'role', 'createdAt']) &&
                       incoming().uid == request.auth.uid &&
                       isValidAdminClaim(incoming());
      allow update, delete: if false;
    }

    match /ownerConfig/{docId} {
      allow get: if isAdmin() && docId == 'meta';
      allow list: if false;
      allow create: if isAdmin() &&
                       docId == 'meta' &&
                       incoming().keys().hasAll(['ownerUid', 'claimed', 'salt', 'passHash', 'updatedBy', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerUid', 'claimed', 'salt', 'passHash', 'updatedBy', 'updatedAt']) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().updatedBy == request.auth.uid &&
                       isValidOwnerMeta(incoming());
      allow update: if isAdmin() &&
                       docId == 'meta' &&
                       incoming().keys().hasOnly(['ownerUid', 'claimed', 'salt', 'passHash', 'updatedBy', 'updatedAt']) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().updatedBy == request.auth.uid &&
                       isValidOwnerMeta(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'claimed', 'salt', 'passHash', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /gameConfig/{docId} {
      allow get: if isSignedIn() && (docId == 'published' || (docId == 'draft' && isAdmin()));
      allow list: if false;
      allow create: if isAdmin() &&
                       (docId == 'published' || docId == 'draft') &&
                       incoming().keys().hasAll(['configJson', 'version', 'updatedBy', 'updatedAt']) &&
                       incoming().keys().hasOnly(['configJson', 'version', 'updatedBy', 'updatedAt', 'publishedAt']) &&
                       incoming().updatedBy == request.auth.uid &&
                       isValidGameConfigDoc(incoming());
      allow update: if isAdmin() &&
                       (docId == 'published' || docId == 'draft') &&
                       incoming().keys().hasOnly(['configJson', 'version', 'updatedBy', 'updatedAt', 'publishedAt']) &&
                       incoming().updatedBy == request.auth.uid &&
                       isValidGameConfigDoc(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['configJson', 'version', 'updatedBy', 'updatedAt', 'publishedAt']);
      allow delete: if isAdmin() && docId == 'draft';

      match /backups/{backupId} {
        allow get: if isAdmin() && docId == 'published' && isValidId(backupId);
        allow list: if isAdmin() && docId == 'published';
        allow create: if isAdmin() &&
                         docId == 'published' &&
                         isValidId(backupId) &&
                         incoming().keys().hasAll(['label', 'configJson', 'version', 'createdBy', 'createdAt']) &&
                         incoming().keys().hasOnly(['label', 'configJson', 'version', 'createdBy', 'createdAt']) &&
                         incoming().createdBy == request.auth.uid &&
                         isValidBackupDoc(incoming());
        allow update: if false;
        allow delete: if isAdmin() && docId == 'published' && isValidId(backupId);
      }
    }

    match /players/{playerId} {
      allow get: if isSignedIn() && isValidId(playerId) && (request.auth.uid == playerId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(playerId) &&
                       request.auth.uid == playerId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'cash', 'xp', 'level',
                         'selectedCityId', 'completedMissionsCount', 'banned', 'resetRequested',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'cash', 'xp', 'level',
                         'selectedCityId', 'completedMissionsCount', 'banned', 'resetRequested',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().userId == request.auth.uid &&
                       incoming().banned == false &&
                       incoming().resetRequested == false &&
                       isValidPlayerDoc(incoming());
      allow update: if isSignedIn() &&
                       isValidId(playerId) &&
                       isValidPlayerDoc(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         (isAdmin() &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'cash', 'xp', 'level', 'selectedCityId',
                             'completedMissionsCount', 'banned', 'resetRequested', 'updatedAt'
                           ])) ||
                         (request.auth.uid == playerId &&
                           incoming().banned == existing().banned &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'cash', 'xp', 'level', 'selectedCityId',
                             'completedMissionsCount', 'resetRequested', 'updatedAt'
                           ]) &&
                           (incoming().resetRequested == existing().resetRequested ||
                             (existing().resetRequested == true && incoming().resetRequested == false)))
                       );
      allow delete: if isAdmin() && isValidId(playerId);
    }
  }
}
